# --- Mitosis Orchestrator (v1.2.0) Codex Configuration Snippet ---

[profiles.mitosis-scout]
model = "gpt-5.6-luna"
model_reasoning_effort = "low"
sandbox_mode = "read-only"

[profiles.mitosis-worker]
model = "codex-mini-latest"
model_reasoning_effort = "medium"
sandbox_mode = "workspace-write"

[mcp_servers.mitosis]
command = "python"
args = ['C:\Users\ivanu\.gemini\config\plugins\mitosis-orchestrator\scripts\mitosis-mcp-server.py']
